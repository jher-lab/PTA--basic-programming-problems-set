本题要求编写程序，计算2个复数的和、差、积、商。

输入格式：
输入在一行中按照a1 b1 a2 b2的格式给出2个复数C1=a1+b1i和C2=a2+b2i的实部和虚部。题目保证C2不为0。

输出格式：
分别在4行中按照(a1+b1i) 运算符 (a2+b2i) = 结果的格式顺序输出2个复数的和、差、积、商，数字精确到小数点后1位。如果结果的实部或者虚部为0，则不输出。如果结果为0，则输出0.0。

输入样例1：
2 3.08 -2.04 5.06
输出样例1：
(2.0+3.1i) + (-2.0+5.1i) = 8.1i
(2.0+3.1i) - (-2.0+5.1i) = 4.0-2.0i
(2.0+3.1i) * (-2.0+5.1i) = -19.7+3.8i
(2.0+3.1i) / (-2.0+5.1i) = 0.4-0.6i
输入样例2：
1 1 -1 -1.01
输出样例2：
(1.0+1.0i) + (-1.0-1.0i) = 0.0
(1.0+1.0i) - (-1.0-1.0i) = 2.0+2.0i
(1.0+1.0i) * (-1.0-1.0i) = -2.0i
(1.0+1.0i) / (-1.0-1.0i) = -1.0
#include<iostream>
#include<cmath>
using namespace std;
void print_complex(double real ,double image){
    if(fabs(real) < 0.05){
        real = 0.0;
    }
    if(fabs(image) < 0.05){
        image = 0.0;
    }
    if(real == 0.0 && image == 0.0){
        printf("0.0");
    }else if(real == 0.0){
        printf("%.1fi",image);
    }else if(image == 0.0){
        printf("%.1f",real);
    }else{
        printf("%.1f%+.1fi",real,image);
    }
}
int main(){
    double a1,b1,a2,b2;
    if(cin >> a1 >> b1 >> a2 >> b2){
        printf("(%.1f%+.1fi) + (%.1f%+.1fi) = ",a1,b1,a2,b2);
        print_complex(a1 + a2,b1 + b2);
        printf("\n");
         printf("(%.1f%+.1fi) - (%.1f%+.1fi) = ",a1,b1,a2,b2);
        print_complex(a1 - a2,b1 - b2);
        printf("\n");
         printf("(%.1f%+.1fi) * (%.1f%+.1fi) = ",a1,b1,a2,b2);
        print_complex(a1 * a2 - b1 * b2,a1 * b2 + a2 * b1);
        printf("\n");
         printf("(%.1f%+.1fi) / (%.1f%+.1fi) = ",a1,b1,a2,b2);
        double denom = a2 * a2 + b2 * b2;
        double res_real = ((a1 * a2 + b1 * b2) / denom);
        double res_image = ((b1 * a2 - a1 * b2) / denom);
        print_complex(res_real,res_image);
        printf("\n");
    }
    return 0;
