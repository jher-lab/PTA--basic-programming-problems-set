#include<iostream>
#include<iomanip>
#include<cmath>
using namespace std;
double a_1 , a_2 , a_3 , a_0;
double f(double x){
    return a_3 * x * x * x + a_2 * x * x + a_1 * x + a_0; 
}
int main(){
    double a,b;
    double mid;
    cin >> a_3 >> a_2 >> a_1 >> a_0;
    cin >> a >> b;
    while(b - a > 0.001){
        mid = (a + b) / 2.0;
        if(fabs(f(mid)) == 0){
            break;
        }
        else if( f(mid) * f(a) > 0){
             a = mid;
        }
        else{
            b = mid;
        }
    }
    cout << fixed << setprecision(2) << (a + b) / 2.0 << endl;
}
